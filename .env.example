# ==============================================================================
# Environment Configuration for sha-mapping-engine_v2
# ==============================================================================

# Server configuration
CONSOLE_HOST=0.0.0.0
CONSOLE_PORT=8099
CONSOLE_RELOAD=false

# Database Configuration (SQL Server 2025 / Azure SQL)
# Option A: Full DSN string
SQL_SERVER_DSN=Driver={ODBC Driver 18 for SQL Server};Server=your_server.database.windows.net,1433;Database=your_db;Uid=your_user;Pwd=your_password;Encrypt=Yes;TrustServerCertificate=Yes;

# Option B: Mode-based config (SHARED, PROD, LOCAL)
# DB_AUTH_MODE=SHARED
# DB_SERVER_SHARED=your_server.database.windows.net
# DB_DATABASE_SHARED=your_db
# DB_USERNAME_SHARED=your_user
# DB_PASSWORD_SHARED=your_password
# DB_DRIVER_SHARED=ODBC Driver 18 for SQL Server

# Azure OpenAI / LLM Configuration
LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_LLM_DEPLOYMENT=gpt-5-nano
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
LLM_TEMPERATURE=0

# Storage and Directories
CHECKPOINT_DIR=/app/data/intermediate
EMBED_CACHE_DIR=/app/cache
ONEDS_FILE=data/1ds.xlsx
MASTER_FILE=data/himalaya_master.xlsx
