# ============================================================
# Database Connection
# ============================================================
# Only this one line controls which block below is used -- flip it back to
# "local" at any time to instantly revert to your own machine, no other
# values need to change.
#   DB_AUTH_MODE=local  -> use the "Local (your machine)" block
#   DB_AUTH_MODE=shared -> use the "Shared (internal dev server)" block
#   DB_AUTH_MODE=prod   -> use the "Production (Azure SQL)" block
DB_AUTH_MODE=shared

# --- Local (your machine, Windows Authentication) --- only read when DB_AUTH_MODE=local; no username/password needed
DB_SERVER_LOCAL=localhost
DB_DATABASE_LOCAL=AureusSentinelV2_latest
DB_DRIVER_LOCAL=ODBC Driver 18 for SQL Server

# --- Shared (internal dev server, SQL Authentication) --- only read when DB_AUTH_MODE=shared
DB_SERVER_SHARED=192.168.0.236
DB_DATABASE_SHARED=AureusSentinelV2
DB_USERNAME_SHARED=sa
DB_PASSWORD_SHARED=sa_1234
DB_DRIVER_SHARED=ODBC Driver 18 for SQL Server

# --- Production (Azure SQL) --- only read when DB_AUTH_MODE=prod
DB_SERVER_PROD=skuharmonizationaccelerator.database.windows.net
DB_DATABASE_PROD=AureusSentinelV2
DB_USERNAME_PROD=SKUHarmonization
DB_PASSWORD_PROD=C0v@lense@123
DB_DRIVER_PROD=ODBC Driver 18 for SQL Server


# Escape hatch: set this to override everything above with one literal DSN
# string, exactly as SQL_SERVER_DSN worked before DB_AUTH_MODE existed. Leave
# it unset to use the mode-based blocks instead -- this is only for a
# connection string the three blocks above can't express (a named instance,
# an unusual driver option, etc).
#SQL_SERVER_DSN=

LLM_PROVIDER=azure
 
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_ENDPOINT=https://covalenseopenaieastus2--resource.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=FdmhgKkXWvPceAOLz51FMSlZH1nsCKv6S4IhMnpdHaLGKRbFQLQxJQQJ99BHACHYHv6XJ3w3AAAAACOG5Juj
AZURE_LLM_DEPLOYMENT=gpt-5.4-mini-1
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Console session signing key. Generated locally; rotate for prod.
CONSOLE_JWT_SECRET=p3B4QLkConZ8f7tJeTS7Hh4Th5dI6Gjz1rtPqneTUC5D8EjZA7C6C6VbpeZpD3yW

